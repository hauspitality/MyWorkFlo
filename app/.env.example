# Copy to .env.local and fill in. Nothing in this file is a real secret.

# --- Supabase (needed starting Phase 0) ---
# Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (needed starting Phase 1, the conversation engine) ---
ANTHROPIC_API_KEY=

# --- Google Calendar OAuth (needed starting Phase 3) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback

# --- Stripe (needed for Phase 0's Checkout flow) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Twilio (only needed starting Phase 5 — not required before then) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
