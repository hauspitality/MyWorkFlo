# Copy to .env.local and fill in. Nothing in this file is a real secret.

# --- Supabase (needed starting Phase 0) ---
# Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (needed starting Phase 1, the conversation engine) ---
# Which provider lib/ai/engine.ts uses. Defaults to "anthropic" — the
# locked stack decision. Set to "moonshot" to test against Kimi K3 instead
# (e.g. no Anthropic key handy yet); see lib/ai/providers/moonshot.ts for
# why that's safe to do without weakening any safety guarantee.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Only needed if AI_PROVIDER=moonshot.
MOONSHOT_API_KEY=

# --- Google Calendar OAuth (needed starting Phase 3) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback

# --- Stripe (needed for Phase 0's Checkout flow) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- App ---
# Must be the real public origin in production: Twilio webhook signature
# validation rebuilds request URLs from it, and approval magic links +
# calendar OAuth redirects embed it.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Dev tools ---
# Set to "true" to allow /dashboard/dev/simulate in a production deploy.
# Leave unset in prod; it's always on in local dev.
ENABLE_DEV_SIMULATOR=

# --- Web Push / PWA (installable app shell + notifications; the actual
# "send a push when X happens" business logic is future work, layered on
# top once conversations/approval_queue events exist) ---
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Ops ---
# Auth for Vercel Cron hitting /api/cron/expire-approvals (Vercel sends it
# as a Bearer token automatically when set on the project).
CRON_SECRET=
# Encrypts Google Calendar OAuth tokens at rest (any long secret; rotating
# it orphans stored tokens and forces a calendar re-connect).
CALENDAR_TOKEN_ENCRYPTION_KEY=
